rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      match /sessions/{sid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // anyone signed in can send a cheer/sticker; only the owner can read/delete them
      match /cheers/{cid} {
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                      && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 40;
        allow read, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
